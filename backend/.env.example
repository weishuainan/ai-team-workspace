DATABASE_URL=postgresql://user:password@host:5432/ai_team
SYNC_API_KEY=replace-with-a-random-secret
JWT_SECRET=replace-with-a-random-secret
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
# openai_responses / openai_chat / openai_compatible / azure_openai / anthropic / gemini / ollama
MODEL_PROVIDER=openai_chat
# Azure OpenAI 等需要固定 API 版本的协议可设置
MODEL_API_VERSION=
# 用于加密用户在页面保存的 API Key；生产环境必须使用稳定的随机值
MODEL_CONFIG_ENCRYPTION_KEY=replace-with-a-long-random-secret
AGENT_MODEL_TIMEOUT_SECONDS=45
# 仅用于本地端到端联调；线上不要开启
AGENT_TEST_MODE=0
# 仅用于比赛演示；真实模型超时后使用带明确标记的备用产出
AGENT_DEMO_MODE=0
APP_FRONTEND_URL=http://localhost:5173
